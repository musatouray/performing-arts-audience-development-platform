# Copy this file to .env and fill in your own values.
# .env is ignored by Git, so these never reach GitHub.
# The scripts put them into config/*.yaml wherever it says ${NAME}.
# Rule: anything that identifies your tenant (IDs, server names, URLs, emails)
# goes here, never in a committed file. Passwords are better avoided altogether:
# sign in with az login, and use Fabric connections or Key Vault inside Fabric.

# Fabric
FABRIC_GIT_CONNECTION_ID=
# Optional: pick the capacity by ID instead of by region (scripts/list_capacities.py)
# FABRIC_CAPACITY_ID=

# Tessitura database: the SQL Server database that plays Tessitura (tickets, constituents)
# On your own computer: localhost (or localhost\INSTANCE for a named instance).
TESSITURA_SQL_SERVER=localhost
TESSITURA_SQL_DATABASE=HarmoniaTessitura
TESSITURA_SQL_AUTH=windows
TESSITURA_SQL_TRUST_SERVER_CERT=yes

# MIP database: the SQL Server database that plays MIP Fund Accounting (the general ledger).
# Same server as Tessitura in this lab; in real life a different one, owned by finance.
MIP_SQL_SERVER=localhost
MIP_SQL_DATABASE=HarmoniaMIP
MIP_SQL_AUTH=windows
MIP_SQL_TRUST_SERVER_CERT=yes
# SQL_USER=
# SQL_PASSWORD=

# Tessitura REST API: the mock API on GitHub Pages (contributions, campaigns, funds)
TESSITURA_API_BASE_URL=https://yourgithubuser.github.io/harmonia-hall-api/v1

# Diese booking API: the mock API on GitHub Pages (rooms, events, bookings)
DIESE_API_BASE_URL=https://yourgithubuser.github.io/harmonia-hall-diese-api/v1

# Education: the SharePoint site that holds the workbooks
EDUCATION_SHAREPOINT_SITE=https://yourtenant.sharepoint.com/sites/yoursite

# Marketing: the ADLS Gen2 storage account and its Fabric connection
MARKETING_ADLS_ACCOUNT_URL=https://yourstorageaccount.dfs.core.windows.net
MARKETING_ADLS_CONNECTION_ID=
