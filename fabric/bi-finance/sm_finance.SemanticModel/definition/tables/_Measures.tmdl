/// Home for every measure, grouped in display folders.
table _Measures
	lineageTag: 67f6ff6d-0c08-4930-a6ce-af478338e7b8

	/// Revenue posted to the ledger (credits less debits on revenue accounts).
	measure Revenue = CALCULATE ( SUM ( fact_gl_entry[net_amount] ), KEEPFILTERS ( dim_account[account_type] = "Revenue" ) )
		formatString: $#,0;($#,0)
		displayFolder: Ledger
		lineageTag: ceae9d0e-edfa-40c8-bd0f-62781d09c7cf

	/// Expenses posted to the ledger, shown as positive amounts.
	measure Expenses = CALCULATE ( - SUM ( fact_gl_entry[net_amount] ), KEEPFILTERS ( dim_account[account_type] = "Expense" ) )
		formatString: $#,0;($#,0)
		displayFolder: Ledger
		lineageTag: b3b2978d-fa0d-458b-981c-2868f98954c4

	/// Revenue minus expenses.
	measure 'Net Surplus' = [Revenue] - [Expenses]
		formatString: $#,0;($#,0)
		displayFolder: Ledger
		lineageTag: 4dc642a8-ade3-4581-8890-564a2c964dea

	/// Tickets, subscriptions and rentals.
	measure 'Earned Revenue' = CALCULATE ( [Revenue], dim_account[account_group] = "Earned Revenue" )
		formatString: $#,0;($#,0)
		displayFolder: Ledger
		lineageTag: ec1d8f7f-0e23-42a7-9432-1e58d43a3e35

	/// Gifts and contributions.
	measure 'Contributed Revenue' = CALCULATE ( [Revenue], dim_account[account_group] = "Contributed Revenue" )
		formatString: $#,0;($#,0)
		displayFolder: Ledger
		lineageTag: d7cffc27-409e-4cc7-a56d-4ce7f089dbf4

	/// Share of revenue the organisation earns rather than raises.
	measure 'Earned Revenue %' = DIVIDE ( [Earned Revenue], [Revenue] )
		formatString: 0.0%
		displayFolder: Ledger
		lineageTag: 3d9e3d7d-bde1-4ffe-b559-8e6c9367f8fe

	measure Debits = SUM ( fact_gl_entry[debit_amount] )
		formatString: $#,0.00
		displayFolder: Ledger
		lineageTag: 1bb5fea1-87cb-404c-9a6b-7272169d7bb3

	measure Credits = SUM ( fact_gl_entry[credit_amount] )
		formatString: $#,0.00
		displayFolder: Ledger
		lineageTag: 79119a45-74fd-4531-8ada-aa30f7111ce0

	/// Always 0: every journal balances. Shown on the Data Trust page.
	measure 'Out of Balance' = [Debits] - [Credits]
		formatString: $#,0.00
		displayFolder: Ledger
		lineageTag: 19fa10ec-ba87-45f3-ba9a-5c1fa27f109f

	/// What Tessitura or Diese recorded.
	measure 'Source Amount' = SUM ( recon_revenue_to_gl[source_amount] )
		formatString: $#,0;($#,0)
		displayFolder: Reconciliation
		lineageTag: e65f2f98-ce08-4c3b-9db0-53a8de7e0c67

	/// What the ledger recorded for the same month, stream and fund.
	measure 'Ledger Amount' = SUM ( recon_revenue_to_gl[gl_amount] )
		formatString: $#,0;($#,0)
		displayFolder: Reconciliation
		lineageTag: 78a3cce9-bdb9-4bf2-97b2-65ed6df9f9dc

	/// Ledger minus source. Negative = the ledger is short.
	measure Variance = [Ledger Amount] - [Source Amount]
		formatString: $#,0;($#,0)
		displayFolder: Reconciliation
		lineageTag: b5fdfa85-e7f9-4c05-8ac1-030e8b364c6c

	measure 'Variance %' = DIVIDE ( [Variance], [Source Amount] )
		formatString: 0.00%
		displayFolder: Reconciliation
		lineageTag: 26214bf6-4a0f-45c2-a927-a78405adc793

	/// Month x stream x fund lines outside tolerance (the larger of $1,000 or 1%).
	measure 'Lines to Investigate' = CALCULATE ( COUNTROWS ( recon_revenue_to_gl ), recon_revenue_to_gl[status] = "Investigate" )
		formatString: #,0
		displayFolder: Reconciliation
		lineageTag: 4c56a86d-f00e-4fba-b626-61e3fd916aa1

	/// Lines to investigate that finance hasn't explained yet.
	measure 'Open Items' = CALCULATE ( COUNTROWS ( recon_revenue_to_gl ), recon_revenue_to_gl[resolution] = "Open" )
		formatString: #,0
		displayFolder: Reconciliation
		lineageTag: c045fc19-ffd2-48a3-8071-a5974e4c1b6b

	/// Share of lines that tie out (matched or within tolerance).
	measure 'Reconciled %' = DIVIDE ( CALCULATE ( COUNTROWS ( recon_revenue_to_gl ), recon_revenue_to_gl[status] <> "Investigate" ), COUNTROWS ( recon_revenue_to_gl ) )
		formatString: 0.0%
		displayFolder: Reconciliation
		lineageTag: 2bebc6c5-be77-41af-85f6-847a295634d5

	measure 'Last Loaded (UTC)' = MAX ( source_freshness[last_loaded_utc] )
		formatString: mmm d, yyyy h:nn AM/PM
		displayFolder: Data Trust
		lineageTag: 1a59f07c-40db-4de3-b584-b08ce579dcb5

	/// The latest business date the platform holds for the source.
	measure 'Data Through' = MAX ( source_freshness[data_through] )
		formatString: mmm d, yyyy
		displayFolder: Data Trust
		lineageTag: 4659a5d2-ffcb-4351-ae8a-1f376840821c

	measure 'Hours Since Load' = DATEDIFF ( [Last Loaded (UTC)], UTCNOW (), HOUR )
		formatString: #,0
		displayFolder: Data Trust
		lineageTag: 5debaf70-fbce-4f58-8226-d6a1e60957e7

	/// Fresh within each source's expected refresh (daily = 26 hours, weekly = 8 days), worked out when the report opens.
	measure 'Freshness Status' =
			VAR Loaded = [Last Loaded (UTC)]
			VAR Sla = MAX ( source_freshness[sla_hours] )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Loaded ), "Never loaded",
			        DATEDIFF ( Loaded, UTCNOW (), HOUR ) <= Sla, "Fresh",
			        "Stale"
			    )
		displayFolder: Data Trust

	/// One line for the top of a page or an Excel sheet: when Tessitura, MIP and Diese were last loaded. A source past its expected refresh is marked STALE.
	measure 'Data Freshness Banner' =
			VAR Sources =
			    FILTER ( source_freshness, source_freshness[source_system] IN { "tessitura", "mip", "diese" } )
			RETURN
			    "Data as of: "
			        & CONCATENATEX (
			            Sources,
			            source_freshness[source_label] & " "
			                & FORMAT ( source_freshness[last_loaded_et], "mmm d h:nn AM/PM" )
			                & IF (
			                    DATEDIFF ( source_freshness[last_loaded_utc], UTCNOW (), HOUR ) > source_freshness[sla_hours],
			                    " STALE (expected " & source_freshness[expected_refresh] & ")"
			                ),
			            " · ",
			            source_freshness[source_label], ASC
			        )
			        & " (ET)"
		displayFolder: Data Trust

	/// For income statement layouts: revenue and expense lines as positive amounts, and Net Surplus on the total row.
	measure 'Statement Amount' = IF ( ISINSCOPE ( dim_account[account_type] ), [Revenue] + [Expenses], [Net Surplus] )
		formatString: $#,0;($#,0)
		displayFolder: Ledger

	/// Size of the variance, for sorting the biggest gaps first.
	measure 'Abs Variance' = ABS ( [Variance] )
		formatString: $#,0
		displayFolder: Reconciliation

	/// Background colour for reconciliation cells: soft red to investigate, soft green when it ties out.
	measure 'Recon Status Color' = IF ( [Lines to Investigate] > 0, "#F6D5D5", "#E2EFE6" )
		isHidden
		displayFolder: Formatting

	/// Font colour for the freshness status.
	measure 'Freshness Color' = SWITCH ( [Freshness Status], "Fresh", "#2E7D4F", "Stale", "#B23A3A", "#7A7F87" )
		isHidden
		displayFolder: Formatting

	/// Net surplus as a share of revenue.
	measure 'Surplus Margin' = DIVIDE ( [Net Surplus], [Revenue] )
		formatString: 0.0%
		displayFolder: Ledger

	/// Last date with activity in the ledger. FYTD comparisons stop here.
	measure 'As Of Date' = VAR k = CALCULATE ( MAX ( fact_gl_entry[effective_date_key] ), REMOVEFILTERS () ) RETURN DATE ( INT ( k / 10000 ), MOD ( INT ( k / 100 ), 100 ), MOD ( k, 100 ) )
		formatString: mmm d, yyyy
		displayFolder: Report

	/// Revenue, fiscal year to date.
	measure 'Revenue FYTD' = CALCULATE ( [Revenue], 'Time Intelligence'[Calculation] = "FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Report\KPI cards

	/// Revenue, same stretch of the prior fiscal year.
	measure 'Revenue PY FYTD' = CALCULATE ( [Revenue], 'Time Intelligence'[Calculation] = "PY FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Report\KPI cards

	/// KPI card detail: change vs the same period last year for Revenue. Formatting only; use Revenue FYTD / Revenue PY FYTD for numbers.
	measure 'Revenue vs PY' = VAR c = [Revenue FYTD] VAR p = [Revenue PY FYTD] VAR d = c - p VAR icon = IF ( d > 0, UNICHAR ( 9650 ), IF ( d < 0, UNICHAR ( 9660 ), UNICHAR ( 9472 ) ) ) RETURN IF ( ISBLANK ( c ) || ISBLANK ( p ), "No prior year", UNICHAR ( 160 ) & IF ( d >= 0, "+", "-" ) & IF ( ABS ( d ) >= 1000000, FORMAT ( ABS ( d ) / 1000000, "$#,0.0" ) & "M", FORMAT ( ABS ( d ) / 1000, "$#,0" ) & "K" ) & " | " & FORMAT ( DIVIDE ( d, ABS ( p ) ), "+0.0%;-0.0%;0.0%" ) & UNICHAR ( 160 ) & icon & UNICHAR ( 160 ) )
		displayFolder: Report\KPI cards

	/// Green when it rises.
	measure 'Revenue vs PY Color' = VAR c = [Revenue FYTD] VAR p = [Revenue PY FYTD] VAR d = c - p RETURN SWITCH ( TRUE (), ISBLANK ( c ) || ISBLANK ( p ), "#607D8B", d > 0, "#2E7D32", d < 0, "#D84315", "#607D8B" )
		displayFolder: Formatting

	/// Expenses, fiscal year to date.
	measure 'Expenses FYTD' = CALCULATE ( [Expenses], 'Time Intelligence'[Calculation] = "FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Report\KPI cards

	/// Expenses, same stretch of the prior fiscal year.
	measure 'Expenses PY FYTD' = CALCULATE ( [Expenses], 'Time Intelligence'[Calculation] = "PY FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Report\KPI cards

	/// KPI card detail: change vs the same period last year for Expenses. Formatting only; use Expenses FYTD / Expenses PY FYTD for numbers.
	measure 'Expenses vs PY' = VAR c = [Expenses FYTD] VAR p = [Expenses PY FYTD] VAR d = c - p VAR icon = IF ( d > 0, UNICHAR ( 9650 ), IF ( d < 0, UNICHAR ( 9660 ), UNICHAR ( 9472 ) ) ) RETURN IF ( ISBLANK ( c ) || ISBLANK ( p ), "No prior year", UNICHAR ( 160 ) & IF ( d >= 0, "+", "-" ) & IF ( ABS ( d ) >= 1000000, FORMAT ( ABS ( d ) / 1000000, "$#,0.0" ) & "M", FORMAT ( ABS ( d ) / 1000, "$#,0" ) & "K" ) & " | " & FORMAT ( DIVIDE ( d, ABS ( p ) ), "+0.0%;-0.0%;0.0%" ) & UNICHAR ( 160 ) & icon & UNICHAR ( 160 ) )
		displayFolder: Report\KPI cards

	/// Green when it falls (lower cost).
	measure 'Expenses vs PY Color' = VAR c = [Expenses FYTD] VAR p = [Expenses PY FYTD] VAR d = c - p RETURN SWITCH ( TRUE (), ISBLANK ( c ) || ISBLANK ( p ), "#607D8B", d < 0, "#2E7D32", d > 0, "#D84315", "#607D8B" )
		displayFolder: Formatting

	/// Net Surplus, fiscal year to date.
	measure 'Net Surplus FYTD' = CALCULATE ( [Net Surplus], 'Time Intelligence'[Calculation] = "FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Report\KPI cards

	/// Net Surplus, same stretch of the prior fiscal year.
	measure 'Net Surplus PY FYTD' = CALCULATE ( [Net Surplus], 'Time Intelligence'[Calculation] = "PY FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Report\KPI cards

	/// KPI card detail: change vs the same period last year for Net Surplus. No % change: a percentage of a small or negative surplus misleads.
	measure 'Net Surplus vs PY' = VAR c = [Net Surplus FYTD] VAR p = [Net Surplus PY FYTD] VAR d = c - p VAR icon = IF ( d > 0, UNICHAR ( 9650 ), IF ( d < 0, UNICHAR ( 9660 ), UNICHAR ( 9472 ) ) ) RETURN IF ( ISBLANK ( c ) || ISBLANK ( p ), "No prior year", UNICHAR ( 160 ) & IF ( d >= 0, "+", "-" ) & IF ( ABS ( d ) >= 1000000, FORMAT ( ABS ( d ) / 1000000, "$#,0.0" ) & "M", FORMAT ( ABS ( d ) / 1000, "$#,0" ) & "K" ) & UNICHAR ( 160 ) & icon & UNICHAR ( 160 ) )
		displayFolder: Report\KPI cards

	/// Green when it rises.
	measure 'Net Surplus vs PY Color' = VAR c = [Net Surplus FYTD] VAR p = [Net Surplus PY FYTD] VAR d = c - p RETURN SWITCH ( TRUE (), ISBLANK ( c ) || ISBLANK ( p ), "#607D8B", d > 0, "#2E7D32", d < 0, "#D84315", "#607D8B" )
		displayFolder: Formatting

	/// Contributed Revenue, fiscal year to date.
	measure 'Contributed Revenue FYTD' = CALCULATE ( [Contributed Revenue], 'Time Intelligence'[Calculation] = "FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Report\KPI cards

	/// Contributed Revenue, same stretch of the prior fiscal year.
	measure 'Contributed Revenue PY FYTD' = CALCULATE ( [Contributed Revenue], 'Time Intelligence'[Calculation] = "PY FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Report\KPI cards

	/// KPI card detail: change vs the same period last year for Contributed Revenue. Formatting only; use Contributed Revenue FYTD / Contributed Revenue PY FYTD for numbers.
	measure 'Contributed Revenue vs PY' = VAR c = [Contributed Revenue FYTD] VAR p = [Contributed Revenue PY FYTD] VAR d = c - p VAR icon = IF ( d > 0, UNICHAR ( 9650 ), IF ( d < 0, UNICHAR ( 9660 ), UNICHAR ( 9472 ) ) ) RETURN IF ( ISBLANK ( c ) || ISBLANK ( p ), "No prior year", UNICHAR ( 160 ) & IF ( d >= 0, "+", "-" ) & IF ( ABS ( d ) >= 1000000, FORMAT ( ABS ( d ) / 1000000, "$#,0.0" ) & "M", FORMAT ( ABS ( d ) / 1000, "$#,0" ) & "K" ) & " | " & FORMAT ( DIVIDE ( d, ABS ( p ) ), "+0.0%;-0.0%;0.0%" ) & UNICHAR ( 160 ) & icon & UNICHAR ( 160 ) )
		displayFolder: Report\KPI cards

	/// Green when it rises.
	measure 'Contributed Revenue vs PY Color' = VAR c = [Contributed Revenue FYTD] VAR p = [Contributed Revenue PY FYTD] VAR d = c - p RETURN SWITCH ( TRUE (), ISBLANK ( c ) || ISBLANK ( p ), "#607D8B", d > 0, "#2E7D32", d < 0, "#D84315", "#607D8B" )
		displayFolder: Formatting

	/// Earned Revenue %, fiscal year to date.
	measure 'Earned Revenue % FYTD' = CALCULATE ( [Earned Revenue %], 'Time Intelligence'[Calculation] = "FYTD" )
		formatString: 0.0%
		displayFolder: Report\KPI cards

	/// Earned Revenue %, same stretch of the prior fiscal year.
	measure 'Earned Revenue % PY FYTD' = CALCULATE ( [Earned Revenue %], 'Time Intelligence'[Calculation] = "PY FYTD" )
		formatString: 0.0%
		displayFolder: Report\KPI cards

	/// KPI card detail: change vs the same period last year for Earned Revenue %. Formatting only.
	measure 'Earned Revenue % vs PY' = VAR c = [Earned Revenue % FYTD] VAR p = [Earned Revenue % PY FYTD] VAR d = c - p VAR icon = IF ( d > 0, UNICHAR ( 9650 ), IF ( d < 0, UNICHAR ( 9660 ), UNICHAR ( 9472 ) ) ) RETURN IF ( ISBLANK ( c ) || ISBLANK ( p ), "No prior year", UNICHAR ( 160 ) & FORMAT ( d * 100, "+0.0;-0.0;0.0" ) & " pts" & UNICHAR ( 160 ) & icon & UNICHAR ( 160 ) )
		displayFolder: Report\KPI cards

	/// Green when it rises.
	measure 'Earned Revenue % vs PY Color' = VAR c = [Earned Revenue % FYTD] VAR p = [Earned Revenue % PY FYTD] VAR d = c - p RETURN SWITCH ( TRUE (), ISBLANK ( c ) || ISBLANK ( p ), "#607D8B", d > 0, "#2E7D32", d < 0, "#D84315", "#607D8B" )
		displayFolder: Formatting

	/// Surplus Margin, fiscal year to date.
	measure 'Surplus Margin FYTD' = CALCULATE ( [Surplus Margin], 'Time Intelligence'[Calculation] = "FYTD" )
		formatString: 0.0%
		displayFolder: Report\KPI cards

	/// Surplus Margin, same stretch of the prior fiscal year.
	measure 'Surplus Margin PY FYTD' = CALCULATE ( [Surplus Margin], 'Time Intelligence'[Calculation] = "PY FYTD" )
		formatString: 0.0%
		displayFolder: Report\KPI cards

	/// KPI card detail: change vs the same period last year for Surplus Margin. Formatting only.
	measure 'Surplus Margin vs PY' = VAR c = [Surplus Margin FYTD] VAR p = [Surplus Margin PY FYTD] VAR d = c - p VAR icon = IF ( d > 0, UNICHAR ( 9650 ), IF ( d < 0, UNICHAR ( 9660 ), UNICHAR ( 9472 ) ) ) RETURN IF ( ISBLANK ( c ) || ISBLANK ( p ), "No prior year", UNICHAR ( 160 ) & FORMAT ( d * 100, "+0.0;-0.0;0.0" ) & " pts" & UNICHAR ( 160 ) & icon & UNICHAR ( 160 ) )
		displayFolder: Report\KPI cards

	/// Green when it rises.
	measure 'Surplus Margin vs PY Color' = VAR c = [Surplus Margin FYTD] VAR p = [Surplus Margin PY FYTD] VAR d = c - p RETURN SWITCH ( TRUE (), ISBLANK ( c ) || ISBLANK ( p ), "#607D8B", d > 0, "#2E7D32", d < 0, "#D84315", "#607D8B" )
		displayFolder: Formatting

	/// Subtitle for page headers: the fiscal year and the dates the numbers cover.
	measure 'Period Label' = VAR AsOf = [As Of Date] VAR fy = SELECTEDVALUE ( dim_date[fiscal_year_label] ) VAR s = MIN ( dim_date[date] ) VAR e = MIN ( MAX ( dim_date[date] ), AsOf ) VAR sp = REPT ( UNICHAR ( 160 ), 2 ) RETURN SWITCH ( TRUE (), ISBLANK ( fy ), "Period:" & sp & "select one fiscal year", s > AsOf, "Period:" & sp & fy & sp & "|" & sp & "no ledger activity yet", "Period:" & sp & fy & " YTD" & sp & "|" & sp & FORMAT ( s, "mmm d, yyyy" ) & " - " & FORMAT ( e, "mmm d, yyyy" ) )
		displayFolder: Report

	/// Plain-English summary of the period for the page header.
	measure 'Finance Narrative' = VAR fy = SELECTEDVALUE ( dim_date[fiscal_year_label], "The selected period" ) VAR r = [Revenue FYTD] VAR rp = [Revenue PY FYTD] VAR e = [Expenses FYTD] VAR s = [Net Surplus FYTD] VAR er = [Earned Revenue % FYTD] VAR inv = [Lines to Investigate] RETURN fy & " to date, the hall has booked " & IF ( ABS ( r ) >= 1000000, FORMAT ( r / 1000000, "$#,0.0" ) & "M", FORMAT ( r / 1000, "$#,0" ) & "K" ) & " of revenue" & IF ( ISBLANK ( rp ), "", " (" & FORMAT ( DIVIDE ( r - rp, rp ), "+0.0%;-0.0%" ) & " vs last year)" ) & " against " & IF ( ABS ( e ) >= 1000000, FORMAT ( e / 1000000, "$#,0.0" ) & "M", FORMAT ( e / 1000, "$#,0" ) & "K" ) & " of expenses, a net " & IF ( s >= 0, "surplus", "deficit" ) & " of " & IF ( ABS ( ABS ( s ) ) >= 1000000, FORMAT ( ABS ( s ) / 1000000, "$#,0.0" ) & "M", FORMAT ( ABS ( s ) / 1000, "$#,0" ) & "K" ) & ". Earned income is " & FORMAT ( er, "0%" ) & " of revenue. " & IF ( inv > 0, FORMAT ( inv, "0" ) & " revenue reconciliation lines are outside tolerance and need review.", "All revenue ties out to the ledger within tolerance." )
		displayFolder: Report

	/// How many sources were loaded within their expected refresh.
	measure 'Sources Fresh' = VAR n = COUNTROWS ( VALUES ( source_freshness[source_name] ) ) VAR f = COUNTROWS ( FILTER ( VALUES ( source_freshness[source_name] ), [Freshness Status] = "Fresh" ) ) RETURN FORMAT ( f + 0, "0" ) & " of " & FORMAT ( n, "0" )
		displayFolder: Data Trust

	measure 'Sources Fresh Color' = VAR n = COUNTROWS ( VALUES ( source_freshness[source_name] ) ) VAR f = COUNTROWS ( FILTER ( VALUES ( source_freshness[source_name] ), [Freshness Status] = "Fresh" ) ) RETURN IF ( f + 0 = n, "#2E7D32", "#D84315" )
		displayFolder: Formatting

	/// Pill background behind the KPI change: the font colour at 90% transparency.
	measure 'Revenue vs PY Background' = VAR c = [Revenue FYTD] VAR p = [Revenue PY FYTD] VAR d = c - p RETURN SWITCH ( TRUE (), ISBLANK ( c ) || ISBLANK ( p ), "#607D8B1A", d > 0, "#2E7D321A", d < 0, "#D843151A", "#607D8B1A" )
		displayFolder: Formatting

	/// Pill background behind the KPI change: the font colour at 90% transparency.
	measure 'Expenses vs PY Background' = VAR c = [Expenses FYTD] VAR p = [Expenses PY FYTD] VAR d = c - p RETURN SWITCH ( TRUE (), ISBLANK ( c ) || ISBLANK ( p ), "#607D8B1A", d < 0, "#2E7D321A", d > 0, "#D843151A", "#607D8B1A" )
		displayFolder: Formatting

	/// Pill background behind the KPI change: the font colour at 90% transparency.
	measure 'Net Surplus vs PY Background' = VAR c = [Net Surplus FYTD] VAR p = [Net Surplus PY FYTD] VAR d = c - p RETURN SWITCH ( TRUE (), ISBLANK ( c ) || ISBLANK ( p ), "#607D8B1A", d > 0, "#2E7D321A", d < 0, "#D843151A", "#607D8B1A" )
		displayFolder: Formatting

	/// Pill background behind the KPI change: the font colour at 90% transparency.
	measure 'Contributed Revenue vs PY Background' = VAR c = [Contributed Revenue FYTD] VAR p = [Contributed Revenue PY FYTD] VAR d = c - p RETURN SWITCH ( TRUE (), ISBLANK ( c ) || ISBLANK ( p ), "#607D8B1A", d > 0, "#2E7D321A", d < 0, "#D843151A", "#607D8B1A" )
		displayFolder: Formatting

	/// Pill background behind the KPI change: the font colour at 90% transparency.
	measure 'Earned Revenue % vs PY Background' = VAR c = [Earned Revenue % FYTD] VAR p = [Earned Revenue % PY FYTD] VAR d = c - p RETURN SWITCH ( TRUE (), ISBLANK ( c ) || ISBLANK ( p ), "#607D8B1A", d > 0, "#2E7D321A", d < 0, "#D843151A", "#607D8B1A" )
		displayFolder: Formatting

	/// Pill background behind the KPI change: the font colour at 90% transparency.
	measure 'Surplus Margin vs PY Background' = VAR c = [Surplus Margin FYTD] VAR p = [Surplus Margin PY FYTD] VAR d = c - p RETURN SWITCH ( TRUE (), ISBLANK ( c ) || ISBLANK ( p ), "#607D8B1A", d > 0, "#2E7D321A", d < 0, "#D843151A", "#607D8B1A" )
		displayFolder: Formatting

	/// Dynamic title for the monthly trend chart.
	measure 'Trend Title' = VAR sel = SUMMARIZE ( 'Trend Metric', 'Trend Metric'[Trend Metric], 'Trend Metric'[Trend Metric Fields] ) VAR metric = IF ( COUNTROWS ( sel ) = 1, MAXX ( sel, 'Trend Metric'[Trend Metric] ), "Revenue" ) RETURN metric & " by month  |  this year vs last year"
		displayFolder: Report

	/// Income statement amount, fiscal year to date.
	measure 'Statement FYTD' = CALCULATE ( [Statement Amount], 'Time Intelligence'[Calculation] = "FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Report\Income statement

	/// Income statement amount, same stretch of the prior fiscal year.
	measure 'Statement PY FYTD' = CALCULATE ( [Statement Amount], 'Time Intelligence'[Calculation] = "PY FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Report\Income statement

	/// Change against the same stretch of the prior year.
	measure 'Statement vs PY' = VAR c = [Statement FYTD] VAR p = [Statement PY FYTD] RETURN IF ( NOT ISBLANK ( c ) && NOT ISBLANK ( p ), c - p )
		formatString: +$#,0;-$#,0;$0
		displayFolder: Report\Income statement

	/// Change against the same stretch of the prior year, as a percentage. Blank on the net surplus total, where a percentage of a small surplus misleads.
	measure 'Statement vs PY %' = VAR c = [Statement FYTD] VAR p = [Statement PY FYTD] RETURN IF ( ISINSCOPE ( dim_account[account_type] ), DIVIDE ( c - p, ABS ( p ) ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Report\Income statement

	/// Empty value for KPI card reference labels that only show a caption.
	measure Caption = UNICHAR ( 160 )
		formatString: @
		isHidden
		displayFolder: Formatting

		annotation PBI_FormatHint = {"isText":true}

	/// Adopted budget for revenue (MIP budget module), spread evenly over each month's days.
	measure 'Revenue Budget' = CALCULATE ( SUM ( fact_budget[budget_amount] ), KEEPFILTERS ( dim_account[account_type] = "Revenue" ) )
		formatString: $#,0;($#,0)
		displayFolder: Budget

	/// Adopted budget for expenses, as a positive amount.
	measure 'Expense Budget' = CALCULATE ( SUM ( fact_budget[budget_amount] ), KEEPFILTERS ( dim_account[account_type] = "Expense" ) )
		formatString: $#,0;($#,0)
		displayFolder: Budget

	/// Budgeted change in net assets.
	measure 'Net Surplus Budget' = [Revenue Budget] - [Expense Budget]
		formatString: $#,0;($#,0)
		displayFolder: Budget

	measure 'Contributed Revenue Budget' = CALCULATE ( [Revenue Budget], dim_account[account_group] = "Contributed Revenue" )
		formatString: $#,0;($#,0)
		displayFolder: Budget

	measure 'Earned Revenue Budget' = CALCULATE ( [Revenue Budget], dim_account[account_group] = "Earned Revenue" )
		formatString: $#,0;($#,0)
		displayFolder: Budget

	measure 'Surplus Margin Budget' = DIVIDE ( [Net Surplus Budget], [Revenue Budget] )
		formatString: 0.0%
		displayFolder: Budget

	/// Revenue budget, fiscal year to date (same days as the actuals).
	measure 'Revenue Budget FYTD' = CALCULATE ( [Revenue Budget], 'Time Intelligence'[Calculation] = "FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Budget\FYTD

	/// Expense budget, fiscal year to date (same days as the actuals).
	measure 'Expense Budget FYTD' = CALCULATE ( [Expense Budget], 'Time Intelligence'[Calculation] = "FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Budget\FYTD

	measure 'Net Surplus Budget FYTD' = CALCULATE ( [Net Surplus Budget], 'Time Intelligence'[Calculation] = "FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Budget\FYTD

	measure 'Contributed Revenue Budget FYTD' = CALCULATE ( [Contributed Revenue Budget], 'Time Intelligence'[Calculation] = "FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Budget\FYTD

	measure 'Earned Revenue Budget FYTD' = CALCULATE ( [Earned Revenue Budget], 'Time Intelligence'[Calculation] = "FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Budget\FYTD

	measure 'Surplus Margin Budget FYTD' = CALCULATE ( [Surplus Margin Budget], 'Time Intelligence'[Calculation] = "FYTD" )
		formatString: 0.0%
		displayFolder: Budget\FYTD

	/// The whole year's adopted expense budget for the selected fiscal year.
	measure 'Expense Budget Full Year' = CALCULATE ( [Expense Budget], REMOVEFILTERS ( dim_date ), VALUES ( dim_date[fiscal_year] ) )
		formatString: $#,0;($#,0)
		displayFolder: Budget

	/// The whole year's adopted revenue budget for the selected fiscal year.
	measure 'Revenue Budget Full Year' = CALCULATE ( [Revenue Budget], REMOVEFILTERS ( dim_date ), VALUES ( dim_date[fiscal_year] ) )
		formatString: $#,0;($#,0)
		displayFolder: Budget

	/// Share of the year's expense budget already spent.
	measure 'Expense Budget Used %' = DIVIDE ( [Expenses FYTD], [Expense Budget Full Year] )
		formatString: 0.0%
		displayFolder: Budget

	measure 'Earned Revenue FYTD' = CALCULATE ( [Earned Revenue], 'Time Intelligence'[Calculation] = "FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Report\KPI cards

	/// Revenue above (+) or below (-) budget, year to date.
	measure 'Revenue vs Budget FYTD' = VAR a = [Revenue FYTD] VAR b = [Revenue Budget FYTD] RETURN IF ( NOT ISBLANK ( a ) || NOT ISBLANK ( b ), a - b )
		formatString: $#,0;($#,0);-
		displayFolder: Budget

	measure 'Revenue vs Budget FYTD %' = DIVIDE ( [Revenue vs Budget FYTD], [Revenue Budget FYTD] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Budget

	/// Under budget (+) or over budget (-), year to date. Positive is favourable.
	measure 'Expenses vs Budget FYTD' = VAR a = [Expenses FYTD] VAR b = [Expense Budget FYTD] RETURN IF ( NOT ISBLANK ( a ) || NOT ISBLANK ( b ), b - a )
		formatString: $#,0;($#,0);-
		displayFolder: Budget

	measure 'Expenses vs Budget FYTD %' = DIVIDE ( [Expenses vs Budget FYTD], [Expense Budget FYTD] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Budget

	/// Change in Operating Cash (account 1010): money in minus money out.
	measure 'Cash Movement' = CALCULATE ( SUM ( fact_gl_entry[debit_amount] ) - SUM ( fact_gl_entry[credit_amount] ), KEEPFILTERS ( dim_account[account_code] = "1010" ) )
		formatString: $#,0;($#,0)
		displayFolder: Cash

	/// Operating Cash at the end of the period (or on the ledger's last day, if sooner).
	measure 'Cash Balance' = VAR e = MIN ( MAX ( dim_date[date] ), [As Of Date] ) RETURN IF ( MIN ( dim_date[date] ) <= [As Of Date], CALCULATE ( [Cash Movement], REMOVEFILTERS ( dim_date ), dim_date[date] <= e ) )
		formatString: $#,0;($#,0)
		displayFolder: Cash

	/// Cash at the same point last year.
	measure 'Cash Balance PY' = CALCULATE ( [Cash Balance], 'Time Intelligence'[Calculation] = "PY FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Cash

	/// Money in: ticketing, subscriptions, gifts and hall rentals.
	measure 'Cash Received' = CALCULATE ( [Cash Movement], dim_source_module[cash_direction] = "In" )
		formatString: $#,0;($#,0)
		displayFolder: Cash

	/// Money out: payroll runs and payments to artists and suppliers.
	measure 'Cash Paid' = - CALCULATE ( [Cash Movement], dim_source_module[cash_direction] = "Out" )
		formatString: $#,0;($#,0)
		displayFolder: Cash

	/// Cash received minus cash paid (the opening balance is not a flow).
	measure 'Net Cash Flow' = [Cash Received] - [Cash Paid]
		formatString: $#,0;($#,0)
		displayFolder: Cash

	/// For cash flow statements: receipts positive, payments in brackets.
	measure 'Cash Flow Amount' = CALCULATE ( [Cash Movement], dim_source_module[cash_direction] IN { "In", "Out" } )
		formatString: $#,0;($#,0)
		displayFolder: Cash

	measure 'Cash Received FYTD' = CALCULATE ( [Cash Received], 'Time Intelligence'[Calculation] = "FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Cash\FYTD

	measure 'Cash Received PY FYTD' = CALCULATE ( [Cash Received], 'Time Intelligence'[Calculation] = "PY FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Cash\FYTD

	measure 'Cash Paid FYTD' = CALCULATE ( [Cash Paid], 'Time Intelligence'[Calculation] = "FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Cash\FYTD

	measure 'Cash Paid PY FYTD' = CALCULATE ( [Cash Paid], 'Time Intelligence'[Calculation] = "PY FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Cash\FYTD

	measure 'Net Cash Flow FYTD' = CALCULATE ( [Net Cash Flow], 'Time Intelligence'[Calculation] = "FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Cash\FYTD

	measure 'Net Cash Flow PY FYTD' = CALCULATE ( [Net Cash Flow], 'Time Intelligence'[Calculation] = "PY FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Cash\FYTD

	measure 'Cash Flow Amount FYTD' = CALCULATE ( [Cash Flow Amount], 'Time Intelligence'[Calculation] = "FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Cash\FYTD

	measure 'Cash Flow Amount PY FYTD' = CALCULATE ( [Cash Flow Amount], 'Time Intelligence'[Calculation] = "PY FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Cash\FYTD

	/// How many days of operating expenses the cash would cover (expenses over the last 365 days).
	measure 'Days Cash on Hand' = VAR e = MIN ( MAX ( dim_date[date] ), [As Of Date] ) VAR spend = CALCULATE ( [Expenses], REMOVEFILTERS ( dim_date ), DATESINPERIOD ( dim_date[date], e, -365, DAY ) ) RETURN IF ( MIN ( dim_date[date] ) <= [As Of Date], DIVIDE ( [Cash Balance], spend / 365 ) )
		formatString: #,0
		displayFolder: Cash

	measure 'Days Cash on Hand PY' = CALCULATE ( [Days Cash on Hand], 'Time Intelligence'[Calculation] = "PY FYTD" )
		formatString: #,0
		displayFolder: Cash

	/// Bills from artists and suppliers not yet paid (paid 30 days after month end).
	measure 'Accounts Payable' = VAR e = MIN ( MAX ( dim_date[date] ), [As Of Date] ) RETURN IF ( MIN ( dim_date[date] ) <= [As Of Date], CALCULATE ( SUM ( fact_gl_entry[credit_amount] ) - SUM ( fact_gl_entry[debit_amount] ), REMOVEFILTERS ( dim_date ), dim_date[date] <= e, dim_account[account_code] = "2100" ) )
		formatString: $#,0;($#,0)
		displayFolder: Cash

	/// Pay staff have earned but not yet received (biweekly payroll, paid in arrears).
	measure 'Accrued Payroll' = VAR e = MIN ( MAX ( dim_date[date] ), [As Of Date] ) RETURN IF ( MIN ( dim_date[date] ) <= [As Of Date], CALCULATE ( SUM ( fact_gl_entry[credit_amount] ) - SUM ( fact_gl_entry[debit_amount] ), REMOVEFILTERS ( dim_date ), dim_date[date] <= e, dim_account[account_code] = "2200" ) )
		formatString: $#,0;($#,0)
		displayFolder: Cash

	/// Accounts payable plus accrued payroll.
	measure 'Owed to Suppliers and Staff' = [Accounts Payable] + [Accrued Payroll]
		formatString: $#,0;($#,0)
		displayFolder: Cash

	measure 'Owed to Suppliers and Staff PY' = CALCULATE ( [Owed to Suppliers and Staff], 'Time Intelligence'[Calculation] = "PY FYTD" )
		formatString: $#,0;($#,0)
		displayFolder: Cash

	/// Actual for the metric picked in the trend toggle.
	measure 'Trend Actual' = VAR sel = SUMMARIZE ( 'Trend Metric', 'Trend Metric'[Trend Metric], 'Trend Metric'[Trend Metric Fields] ) VAR m = IF ( COUNTROWS ( sel ) = 1, MAXX ( sel, 'Trend Metric'[Trend Metric] ), "Revenue" ) VAR v = SWITCH ( m, "Expenses", [Expenses], "Net Surplus", [Net Surplus], [Revenue] ) RETURN IF ( MIN ( dim_date[date] ) <= [As Of Date], v )
		formatString: $#,0;($#,0)
		displayFolder: Report\Trend

	measure 'Trend Budget' = VAR sel = SUMMARIZE ( 'Trend Metric', 'Trend Metric'[Trend Metric], 'Trend Metric'[Trend Metric Fields] ) VAR m = IF ( COUNTROWS ( sel ) = 1, MAXX ( sel, 'Trend Metric'[Trend Metric] ), "Revenue" ) RETURN SWITCH ( m, "Expenses", [Expense Budget], "Net Surplus", [Net Surplus Budget], [Revenue Budget] )
		formatString: $#,0;($#,0)
		displayFolder: Report\Trend

	measure 'Trend Last Year' = CALCULATE ( [Trend Actual], 'Time Intelligence'[Calculation] = "PY" )
		formatString: $#,0;($#,0)
		displayFolder: Report\Trend

	measure 'SoA Actual' = VAR t = SELECTEDVALUE ( 'Statement Line'[Line Type] ) VAR c = SELECTEDVALUE ( 'Statement Line'[Account Code] ) RETURN SWITCH ( t, "Account", CALCULATE ( [Revenue] + [Expenses], dim_account[account_code] = c ), "Total Revenue", [Revenue], "Total Expenses", [Expenses], "Net", [Net Surplus], "Ratio", [Surplus Margin] )
		isHidden
		displayFolder: Statement of Activities

	measure 'SoA Budget' = VAR t = SELECTEDVALUE ( 'Statement Line'[Line Type] ) VAR c = SELECTEDVALUE ( 'Statement Line'[Account Code] ) RETURN SWITCH ( t, "Account", CALCULATE ( [Revenue Budget] + [Expense Budget], dim_account[account_code] = c ), "Total Revenue", [Revenue Budget], "Total Expenses", [Expense Budget], "Net", [Net Surplus Budget], "Ratio", [Surplus Margin Budget] )
		isHidden
		displayFolder: Statement of Activities

	/// Statement of Activities: actual, fiscal year to date.
	measure Actual = CALCULATE ( [SoA Actual], 'Time Intelligence'[Calculation] = "FYTD" )
		displayFolder: Statement of Activities

		formatStringDefinition = IF ( SELECTEDVALUE ( 'Statement Line'[Line Type] ) = "Ratio", "0.0%", "$#,0;($#,0);-" )

	/// Statement of Activities: adopted budget for the same days.
	measure Budget = CALCULATE ( [SoA Budget], 'Time Intelligence'[Calculation] = "FYTD" )
		displayFolder: Statement of Activities

		formatStringDefinition = IF ( SELECTEDVALUE ( 'Statement Line'[Line Type] ) = "Ratio", "0.0%", "$#,0;($#,0);-" )

	/// Statement of Activities: the same stretch of last year.
	measure 'Last Year' = CALCULATE ( [SoA Actual], 'Time Intelligence'[Calculation] = "PY FYTD" )
		displayFolder: Statement of Activities

		formatStringDefinition = IF ( SELECTEDVALUE ( 'Statement Line'[Line Type] ) = "Ratio", "0.0%", "$#,0;($#,0);-" )

	/// Favourable (+) or unfavourable (-) against budget: revenue above budget or expenses below it.
	measure 'vs Budget' = VAR t = SELECTEDVALUE ( 'Statement Line'[Line Type] ) VAR c = SELECTEDVALUE ( 'Statement Line'[Account Code] ) VAR exp = t = "Total Expenses" || ( t = "Account" && LEFT ( c, 1 ) = "5" ) VAR a = [Actual] VAR b = [Budget] RETURN IF ( NOT ISBLANK ( a ) || NOT ISBLANK ( b ), IF ( exp, b - a, a - b ) )
		displayFolder: Statement of Activities

		formatStringDefinition = IF ( SELECTEDVALUE ( 'Statement Line'[Line Type] ) = "Ratio", "+0.0%;-0.0%;-", "$#,0;($#,0);-" )

	/// Variance against budget as a percentage. Blank for change in net assets, where a percentage of a small surplus misleads.
	measure 'vs Budget %' = VAR t = SELECTEDVALUE ( 'Statement Line'[Line Type] ) VAR c = SELECTEDVALUE ( 'Statement Line'[Account Code] ) VAR exp = t = "Total Expenses" || ( t = "Account" && LEFT ( c, 1 ) = "5" ) VAR a = [Actual] VAR b = [Budget] RETURN IF ( t <> "Ratio" && t <> "Net", DIVIDE ( IF ( exp, b - a, a - b ), ABS ( b ) ) )
		formatString: +0.0%;-0.0%;-
		displayFolder: Statement of Activities

	/// Favourable (+) or unfavourable (-) against last year.
	measure 'vs Last Year' = VAR t = SELECTEDVALUE ( 'Statement Line'[Line Type] ) VAR c = SELECTEDVALUE ( 'Statement Line'[Account Code] ) VAR exp = t = "Total Expenses" || ( t = "Account" && LEFT ( c, 1 ) = "5" ) VAR a = [Actual] VAR p = [Last Year] RETURN IF ( NOT ISBLANK ( a ) && NOT ISBLANK ( p ), IF ( exp, p - a, a - p ) )
		displayFolder: Statement of Activities

		formatStringDefinition = IF ( SELECTEDVALUE ( 'Statement Line'[Line Type] ) = "Ratio", "+0.0%;-0.0%;-", "$#,0;($#,0);-" )

	measure 'vs Last Year %' = VAR t = SELECTEDVALUE ( 'Statement Line'[Line Type] ) VAR c = SELECTEDVALUE ( 'Statement Line'[Account Code] ) VAR exp = t = "Total Expenses" || ( t = "Account" && LEFT ( c, 1 ) = "5" ) VAR a = [Actual] VAR p = [Last Year] RETURN IF ( t <> "Ratio" && t <> "Net", DIVIDE ( IF ( exp, p - a, a - p ), ABS ( p ) ) )
		formatString: +0.0%;-0.0%;-
		displayFolder: Statement of Activities

	measure 'SoA Row Background' = VAR t = SELECTEDVALUE ( 'Statement Line'[Line Type] ) RETURN SWITCH ( t, "Header", "#D5DFEC", "Total Revenue", "#EEF2F7", "Total Expenses", "#EEF2F7", "Net", "#1E3A5F", "Ratio", "#EEF2F7", "#FFFFFF" )
		displayFolder: Formatting

	/// Section rows (Revenue, Expenses) and totals in navy; account sub-rows in a softer grey so the sections carry more weight.
	measure 'SoA Row Font' = VAR t = SELECTEDVALUE ( 'Statement Line'[Line Type] ) RETURN SWITCH ( t, "Net", "#FFFFFF", "Account", "#5B6B80", "#1E3A5F" )
		displayFolder: Formatting

	measure 'SoA vs Budget Font' = VAR t = SELECTEDVALUE ( 'Statement Line'[Line Type] ) RETURN IF ( t = "Net", "#FFFFFF", IF ( [vs Budget] < 0, "#D84315", "#2E7D32" ) )
		displayFolder: Formatting

	measure 'SoA vs PY Font' = VAR t = SELECTEDVALUE ( 'Statement Line'[Line Type] ) RETURN IF ( t = "Net", "#FFFFFF", IF ( [vs Last Year] < 0, "#D84315", "#2E7D32" ) )
		displayFolder: Formatting

	measure 'Statement Title' = "Statement of Activities  |  " & SELECTEDVALUE ( dim_date[fiscal_year_label], "All years" ) & " year to date"
		displayFolder: Report

	/// KPI pill: Revenue against budget.
	measure 'Revenue vs Budget' = Fmt.Change ( [Revenue FYTD], [Revenue Budget FYTD], "money", "No budget" )
		displayFolder: Report\KPI cards

	measure 'Revenue vs Budget Color' = Color.Change ( [Revenue FYTD], [Revenue Budget FYTD], TRUE, "" )
		displayFolder: Formatting

	measure 'Revenue vs Budget Background' = Color.Change ( [Revenue FYTD], [Revenue Budget FYTD], TRUE, "1A" )
		displayFolder: Formatting

	/// KPI pill: Expenses against budget.
	measure 'Expenses vs Budget' = Fmt.Change ( [Expenses FYTD], [Expense Budget FYTD], "money", "No budget" )
		displayFolder: Report\KPI cards

	measure 'Expenses vs Budget Color' = Color.Change ( [Expenses FYTD], [Expense Budget FYTD], FALSE, "" )
		displayFolder: Formatting

	measure 'Expenses vs Budget Background' = Color.Change ( [Expenses FYTD], [Expense Budget FYTD], FALSE, "1A" )
		displayFolder: Formatting

	/// KPI pill: Net Surplus against budget.
	measure 'Net Surplus vs Budget' = Fmt.Change ( [Net Surplus FYTD], [Net Surplus Budget FYTD], "money_only", "No budget" )
		displayFolder: Report\KPI cards

	measure 'Net Surplus vs Budget Color' = Color.Change ( [Net Surplus FYTD], [Net Surplus Budget FYTD], TRUE, "" )
		displayFolder: Formatting

	measure 'Net Surplus vs Budget Background' = Color.Change ( [Net Surplus FYTD], [Net Surplus Budget FYTD], TRUE, "1A" )
		displayFolder: Formatting

	/// KPI pill: Contributed Revenue against budget.
	measure 'Contributed Revenue vs Budget' = Fmt.Change ( [Contributed Revenue FYTD], [Contributed Revenue Budget FYTD], "money", "No budget" )
		displayFolder: Report\KPI cards

	measure 'Contributed Revenue vs Budget Color' = Color.Change ( [Contributed Revenue FYTD], [Contributed Revenue Budget FYTD], TRUE, "" )
		displayFolder: Formatting

	measure 'Contributed Revenue vs Budget Background' = Color.Change ( [Contributed Revenue FYTD], [Contributed Revenue Budget FYTD], TRUE, "1A" )
		displayFolder: Formatting

	/// KPI pill: Earned Revenue against budget.
	measure 'Earned Revenue vs Budget' = Fmt.Change ( [Earned Revenue FYTD], [Earned Revenue Budget FYTD], "money", "No budget" )
		displayFolder: Report\KPI cards

	measure 'Earned Revenue vs Budget Color' = Color.Change ( [Earned Revenue FYTD], [Earned Revenue Budget FYTD], TRUE, "" )
		displayFolder: Formatting

	measure 'Earned Revenue vs Budget Background' = Color.Change ( [Earned Revenue FYTD], [Earned Revenue Budget FYTD], TRUE, "1A" )
		displayFolder: Formatting

	/// KPI pill: Surplus Margin against budget.
	measure 'Surplus Margin vs Budget' = Fmt.Change ( [Surplus Margin FYTD], [Surplus Margin Budget FYTD], "pct", "No budget" )
		displayFolder: Report\KPI cards

	measure 'Surplus Margin vs Budget Color' = Color.Change ( [Surplus Margin FYTD], [Surplus Margin Budget FYTD], TRUE, "" )
		displayFolder: Formatting

	measure 'Surplus Margin vs Budget Background' = Color.Change ( [Surplus Margin FYTD], [Surplus Margin Budget FYTD], TRUE, "1A" )
		displayFolder: Formatting

	/// KPI pill: Cash Balance against the same point last year.
	measure 'Cash Balance vs PY' = Fmt.Change ( [Cash Balance], [Cash Balance PY], "money_only", "No prior year" )
		displayFolder: Report\KPI cards

	measure 'Cash Balance vs PY Color' = Color.Change ( [Cash Balance], [Cash Balance PY], TRUE, "" )
		displayFolder: Formatting

	measure 'Cash Balance vs PY Background' = Color.Change ( [Cash Balance], [Cash Balance PY], TRUE, "1A" )
		displayFolder: Formatting

	/// KPI pill: Days Cash on Hand against the same point last year.
	measure 'Days Cash on Hand vs PY' = Fmt.Change ( [Days Cash on Hand], [Days Cash on Hand PY], "days", "No prior year" )
		displayFolder: Report\KPI cards

	measure 'Days Cash on Hand vs PY Color' = Color.Change ( [Days Cash on Hand], [Days Cash on Hand PY], TRUE, "" )
		displayFolder: Formatting

	measure 'Days Cash on Hand vs PY Background' = Color.Change ( [Days Cash on Hand], [Days Cash on Hand PY], TRUE, "1A" )
		displayFolder: Formatting

	/// KPI pill: Net Cash Flow against the same point last year.
	measure 'Net Cash Flow vs PY' = Fmt.Change ( [Net Cash Flow FYTD], [Net Cash Flow PY FYTD], "money_only", "No prior year" )
		displayFolder: Report\KPI cards

	measure 'Net Cash Flow vs PY Color' = Color.Change ( [Net Cash Flow FYTD], [Net Cash Flow PY FYTD], TRUE, "" )
		displayFolder: Formatting

	measure 'Net Cash Flow vs PY Background' = Color.Change ( [Net Cash Flow FYTD], [Net Cash Flow PY FYTD], TRUE, "1A" )
		displayFolder: Formatting

	/// KPI pill: Cash Received against the same point last year.
	measure 'Cash Received vs PY' = Fmt.Change ( [Cash Received FYTD], [Cash Received PY FYTD], "money", "No prior year" )
		displayFolder: Report\KPI cards

	measure 'Cash Received vs PY Color' = Color.Change ( [Cash Received FYTD], [Cash Received PY FYTD], TRUE, "" )
		displayFolder: Formatting

	measure 'Cash Received vs PY Background' = Color.Change ( [Cash Received FYTD], [Cash Received PY FYTD], TRUE, "1A" )
		displayFolder: Formatting

	/// KPI pill: Cash Paid against the same point last year.
	measure 'Cash Paid vs PY' = Fmt.Change ( [Cash Paid FYTD], [Cash Paid PY FYTD], "money", "No prior year" )
		displayFolder: Report\KPI cards

	measure 'Cash Paid vs PY Color' = Color.Change ( [Cash Paid FYTD], [Cash Paid PY FYTD], FALSE, "" )
		displayFolder: Formatting

	measure 'Cash Paid vs PY Background' = Color.Change ( [Cash Paid FYTD], [Cash Paid PY FYTD], FALSE, "1A" )
		displayFolder: Formatting

	/// KPI pill: money owed to suppliers and staff against the same point last year.
	measure 'Owed vs PY' = Fmt.Change ( [Owed to Suppliers and Staff], [Owed to Suppliers and Staff PY], "money_only", "No prior year" )
		displayFolder: Report\KPI cards

	measure 'Owed vs PY Color' = Color.Change ( [Owed to Suppliers and Staff], [Owed to Suppliers and Staff PY], FALSE, "" )
		displayFolder: Formatting

	measure 'Owed vs PY Background' = Color.Change ( [Owed to Suppliers and Staff], [Owed to Suppliers and Staff PY], FALSE, "1A" )
		displayFolder: Formatting

	/// Cash at the end of the same month last year (for monthly trend charts).
	measure 'Cash Balance Last Year' = CALCULATE ( [Cash Balance], 'Time Intelligence'[Calculation] = "PY" )
		formatString: $#,0;($#,0)
		displayFolder: Cash

	measure 'Revenue Last Year' = CALCULATE ( [Revenue], 'Time Intelligence'[Calculation] = "PY" )
		formatString: $#,0;($#,0)
		displayFolder: Report\Trend

	measure 'Expenses Last Year' = CALCULATE ( [Expenses], 'Time Intelligence'[Calculation] = "PY" )
		formatString: $#,0;($#,0)
		displayFolder: Report\Trend

	/// Revenue, blank for months after the ledger's last day (so charts stop at today).
	measure 'Revenue Actual to Date' = IF ( MIN ( dim_date[date] ) <= [As Of Date], [Revenue] )
		formatString: $#,0;($#,0)
		displayFolder: Report\Trend

	measure 'Expenses Actual to Date' = IF ( MIN ( dim_date[date] ) <= [As Of Date], [Expenses] )
		formatString: $#,0;($#,0)
		displayFolder: Report\Trend

	column placeholder
		isHidden
		lineageTag: 8334bced-3def-4ea3-8740-4cb06f12a963
		isNameInferred
		sourceColumn: [placeholder]

	partition _Measures = calculated
		mode: import
		source = ROW("placeholder", BLANK())

