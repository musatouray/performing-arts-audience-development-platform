	column fund_name
		dataType: string
		lineageTag: 531013e6-7653-417d-8a97-07ae9ffcab7d
		sourceLineageTag: fund_name
		summarizeBy: none
		sourceColumn: fund_name

		annotation SummarizationSetBy = Automatic

	column is_restricted
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
