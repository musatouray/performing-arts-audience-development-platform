	sourceLineageTag: [dim].[fund]

	column fund_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 17849cac-7aea-4391-a8e4-adc5bdccbc25
		sourceLineageTag: fund_key
		summarizeBy: sum
		sourceColumn: fund_key

		annotation SummarizationSetBy = Automatic

	column fund_id
		dataType: string
		lineageTag: ad946e09-6855-49cd-b119-ba7ef6a3b042
		sourceLineageTag: fund_id
