          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How these checks work",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#0B2545"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022 Every journal in the ledger balances; Out of balance must be $0.00.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2A37"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022 Tessitura and Diese revenue are reconciled to the ledger every night; lines outside tolerance appear on the Reconciliation page until finance explains them.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2A37"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022 Freshness comes from the platform's run log: a source counts as current when the nightly run checked it, even if nothing changed.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2A37"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022 Definitions live in the certified semantic model sm_finance, so Excel, this report and SQL users get the same numbers.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1F2A37"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
      ]
