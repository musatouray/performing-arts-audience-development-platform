    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How these checks work",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "14pt",
                      "color": "#1E3A5F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Every journal in the ledger balances; out of balance must be $0.00.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#1E3A5F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Tessitura and Diese revenue are reconciled to the ledger every night; lines outside tolerance stay on the Reconciliation page until finance explains them.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#1E3A5F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Freshness comes from the platform's run log: a source counts as current when the nightly run checked it, even if nothing changed.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#1E3A5F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Every number comes from the certified semantic model sm_finance, so Excel, this report and SQL users see the same figures.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#1E3A5F"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
