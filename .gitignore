# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Generated data & tenant-specific IDs (never commit)
data/
config/.generated/
.env
.env.*
!.env.example
*.local.*
*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Power BI Desktop local files (per user, never committed)
**/.pbi/localSettings.json
**/.pbi/cache.abf

# Claude Code: local settings and generated reports (query results, never commit)
.claude/settings.local.json
.claude/reports/

# Node / Fabric Apps (Rayfin) projects: dependencies, builds, local settings and deployment IDs
node_modules/
dist/
**/rayfin/.env
**/rayfin/.temp/
.env.fabric*
.env.local
