    int patron_key PK "SCD2 version"
    string patron_id "golden person ID"
    string region
    string email "masked"
    datetime valid_from
    datetime valid_to
    bit is_current
  }
  DIM_PERFORMANCE {
    int performance_key PK
    string series
    string season_name
    string venue_name
    int capacity
  }
  DIM_VENUE {
    int venue_key PK
    string venue_name
    int capacity "sell-through"
