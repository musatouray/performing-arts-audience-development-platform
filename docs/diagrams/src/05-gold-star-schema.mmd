  FACT_TICKET_SALES {
    string order_line_id "grain: order line"
    int patron_key FK
    int performance_key FK
    int order_date_key FK
    int performance_date_key FK
    int quantity
    decimal net_amount
    bit is_returned
  }
  FACT_GIFTS {
    string gift_id "grain: gift"
    int patron_key FK
    int campaign_key FK
    decimal amount
    bit is_anonymous "RLS"
  }
  FACT_SUBSCRIPTIONS {
    string subscription_id "grain: package"
    int patron_key FK
    int fiscal_year
    bit is_renewal
  }
  FACT_EDUCATION_SESSIONS {
    string enrollment_id "grain: session"
    int program_key FK
    int school_key FK
    int participants "aggregate, no PII"
  }
  DIM_PATRON {
    int patron_key PK "SCD2 version"
    string patron_id "golden person ID"
    string region
    string email "masked"
    datetime valid_from
    datetime valid_to
    bit is_current
  }
  DIM_PERFORMANCE {
    int performance_key PK
    string series
    string season_name
    string venue_name
    int capacity
  }
  DIM_VENUE {
    int venue_key PK
    string venue_name
    int capacity "sell-through"
  }
  DIM_ROOM {
    int room_key PK
    string room_name "Diese room"
    int venue_key FK "-1 if not a hall"
    decimal hourly_rate
  }
  DIM_EVENT {
    int event_key PK "bridge: Diese event"
    string event_id
    int performance_key FK "-1 if not ticketed"
    string event_type "Concert, Rental, Rehearsal"
    bit is_linked
  }
  FACT_VENUE_BOOKING {
    string booking_id "grain: room booking"
    int event_key FK
    int room_key FK
    int booking_date_key FK
    decimal hours_booked
    decimal rental_fee
  }
  FIN_DIM_ACCOUNT {
    int account_key PK
    string account_code "MIP chart of accounts"
    string account_group
  }
  FIN_DIM_DEPARTMENT {
    int department_key PK
    string department_code
  }
  FIN_FACT_GL_ENTRY {
    string gl_transaction_id "grain: journal line"
    int account_key FK
    int fund_key FK
    int department_key FK
    int effective_date_key FK
    decimal net_amount "credit - debit"
  }
  FIN_RECON_REVENUE_TO_GL {
    date month_start "grain: month x stream x fund"
    string revenue_stream
    decimal source_amount
    decimal gl_amount
    string status "Matched, Within tolerance, Investigate"
  }
  DIM_DATE {
    int date_key PK
    int fiscal_year "Jul-Jun"
    int fiscal_month_num
  }
