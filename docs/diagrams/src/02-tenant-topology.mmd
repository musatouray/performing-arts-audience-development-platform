%% Tenant topology: domains organise; WORKSPACE roles grant access
flowchart TB
  classDef dom fill:#EDE7F6,stroke:#5E35B1,color:#26134D
  classDef dev fill:#E3F2FD,stroke:#1565C0,color:#0D2A4D
  classDef test fill:#FFF8E1,stroke:#F9A825,color:#3D2E00
  classDef prod fill:#E8F5E9,stroke:#2E7D32,color:#123D16
  classDef cap fill:#FCE4EC,stroke:#AD1457,color:#3D0A1F
  classDef serves fill:#FFFFDE,stroke:#FFFFDE,color:#424242,font-style:italic

  TEN["Fabric tenant · tenant settings audited (scripts/08)<br/>Capacity: F64 (trial in the mock) → all 15 workspaces<br/>BI models read Gold of the SAME env (deployment rules rebind)"]:::cap
  ORG["Parent domain: Harmonia Hall<br/>Domain admins: sg-hh-fabric-admins (inherited by subdomains)<br/>Domain roles organise & delegate — they grant NO data access"]:::dom
  TEN --> ORG

