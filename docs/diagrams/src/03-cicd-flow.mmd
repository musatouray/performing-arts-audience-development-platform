%% CI/CD: Git integration on DEV, deployment pipelines to TEST/PROD, stage values from variable libraries
flowchart TB
  classDef gh fill:#F6F8FA,stroke:#24292F,color:#24292F
  classDef dev fill:#E3F2FD,stroke:#1565C0,color:#0D2A4D
  classDef test fill:#FFF8E1,stroke:#F9A825,color:#3D2E00
  classDef prod fill:#E8F5E9,stroke:#2E7D32,color:#123D16
  classDef vl fill:#EDE7F6,stroke:#5E35B1,color:#26134D

  subgraph GH["GitHub"]
    direction LR
    FB["dev branch<br/>scripts · SQL · report generator"]:::gh --> PR["CI on every push<br/>lint · config validation · tests"]:::gh --> MAIN["main<br/>fabric/ · src/warehouse"]:::gh
  end

  subgraph FAB["Fabric: one deployment pipeline per workspace family"]
    direction LR
    DEV["DEV<br/>Git-connected to main"]:::dev -- "deploy" --> TEST["TEST<br/>sign-off by business owners"]:::test -- "deploy" --> PROD["PROD<br/>certified models · apps · Excel"]:::prod
  end

  VL["Variable libraries (vl_platform, vl_finance)<br/>one active value set per stage: warehouse, lakehouses,<br/>connections, and which Gold each model reads"]:::vl
  SQL["13_deploy_gold_sql.py<br/>the same Gold schema in every stage, safe to re-run"]:::gh

  MAIN -- "Update all" --> DEV
  MAIN --> SQL
  SQL -.-> FAB
  VL -.-> FAB
